# Copy to .env.local for local development, and add the same two values in
# Vercel -> Project -> Settings -> Environment Variables for the deployed app.
# Both come from Supabase -> Project Settings -> API (Data API / API Keys).

# Project URL, for example https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The service_role (secret) key. Server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts saved API keys and connection tokens. 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it the same forever: if it changes, saved keys can no longer be read.
WML_ENCRYPTION_KEY=
