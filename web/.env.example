# Copy to .env.local for local development, and add the same two values in
# Vercel -> Project -> Settings -> Environment Variables for the deployed app.
# Both come from Supabase -> Project Settings -> API (Data API / API Keys).

# Project URL, for example https://abcdefghijkl.supabase.co
SUPABASE_URL=

# The service_role (secret) key. Server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts saved API keys and connection tokens. 32 random bytes, base64. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it the same forever: if it changes, saved keys can no longer be read.
WML_ENCRYPTION_KEY=

# The deployed address, for example https://your-app.vercel.app. Claude connector URLs always use it,
# even when made while running locally. On Vercel it defaults to the production domain.
APP_URL=

# Google Calendar sync (study sessions written to a "Where MyLife" calendar, with reminders).
# Google Cloud Console -> APIs & Services -> Credentials -> the OAuth "Web client" (the one Supabase uses).
# Also: enable "Google Calendar API", add <app address>/api/gcal/callback to Authorized redirect URIs,
# add the scope .../auth/calendar.app.created on the consent screen, and publish the app (Testing mode
# makes the login expire after 7 days).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local development only: /auth/dev signs in as this email without Google. Leave unset in production.
# WML_DEV_LOGIN=you@example.com
